# Salin ke .env lalu isi dengan nilai asli. JANGAN commit file .env.
# Semua nilai di bawah hanyalah placeholder.

# ===== SERVER =====
PORT=3000
# Daftar origin frontend, dipisah koma. Wajib diisi di produksi.
FRONTEND_ORIGINS=https://komunikasi-group.netlify.app
# Jumlah proxy di depan server (Railway/Netlify = 1). Dipakai untuk rate limit per IP.
TRUST_PROXY_HOPS=1

# ===== ADMIN =====
# Username akun admin di tabel users. Password TIDAK disimpan di env:
# admin login memakai password_hash milik user tersebut di database.
ADMIN_NAME=

# ===== DATABASE (PostgreSQL / Supabase) =====
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Set true jika CA sertifikat server tervalidasi.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ===== SESSION / TOKEN =====
USER_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=600000
ADMIN_KICK_DURATION_MS=300000
STALE_SESSION_MS=65000

# ===== RECORDING (Supabase Storage) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECORDING_BUCKET=voice-recordings
RECORDING_MAX_SIZE_BYTES=26214400
RECORDING_MAX_DURATION_MS=300000
RECORDING_TTL_DAYS=7

# ===== STATISTIK ADMIN =====
ADMIN_ACTIVITY_MONTHS=12

# ===== CLOUDFLARE TURN =====
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
