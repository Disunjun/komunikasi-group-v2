# ===========================================
# KONFIGURASI SERVER KOMUNIKASI GROUP REALTIME
# ===========================================

# Port server (default: 3000)
PORT=3000

# Origins frontend yang diizinkan (comma-separated, gunakan * untuk semua)
FRONTEND_ORIGINS=*

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# URL database PostgreSQL (WAJIB untuk fitur lengkap)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ===========================================
# ADMIN CREDENTIALS - WAJIB DIKONFIGURASI!
# ===========================================
# Username admin (tidak ada default - HARUS diset!)
ADMIN_NAME=

# Password admin (tidak ada default - HARUS diset!)
ADMIN_PASSWORD=

# Session timeout untuk admin dalam milidetik (default: 30 menit)
ADMIN_SESSION_TTL_MS=1800000

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
# Maksimal percobaan login admin (default: 5)
ADMIN_LOGIN_MAX_ATTEMPTS=5

# Jendela waktu rate limiting dalam ms (default: 10 menit)
ADMIN_LOGIN_WINDOW_MS=600000

# ===========================================
# KICK DURATION
# ===========================================
# Durasi kick user dalam ms (default: 5 menit)
ADMIN_KICK_DURATION_MS=300000

# ===========================================
# CLOUDFLARE TURN CONFIGURATION (Optional)
# ===========================================
# Cloudflare TURN Key ID
CLOUDFLARE_TURN_KEY_ID=

# Cloudflare TURN API Token
CLOUDFLARE_TURN_API_TOKEN=
